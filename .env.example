# Remplacez MOT_DE_PASSE par celui de votre utilisateur PostgreSQL.
DATABASE_URL="postgresql://postgres:MOT_DE_PASSE@localhost:5432/place_commune"

# Clé de signature des sessions, 32 caractères minimum. Pour en générer une :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Code d'accès à /moderation, 12 caractères minimum. Sans lui, l'espace de modération reste fermé.
MODERATION_CODE=

# Facultatif : active la seconde lecture des idées par Claude. Sans clé, seules les règles locales s'appliquent.
# ANTHROPIC_API_KEY=
