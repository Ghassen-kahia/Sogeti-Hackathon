generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Un habitant. Volontairement minimal : un pseudo, aucune donnée personnelle ni mot de passe.
model User {
  id          Int      @id @default(autoincrement())
  nickname    String   @db.VarChar(24)
  /// Pseudo en minuscules : garantit l'unicité sans tenir compte de la casse.
  nicknameKey String   @unique @map("nickname_key") @db.VarChar(24)
  createdAt   DateTime @default(now()) @map("created_at")

  suggestions  Suggestion[]
  votes        Vote[]
  signalements Signalement[]

  @@map("users")
}

model Categorie {
  id      Int    @id @default(autoincrement())
  nom     String @unique @db.VarChar(60)
  slug    String @unique @db.VarChar(60)
  /// Couleur hexadécimale (#rrggbb) utilisée pour les badges et les épingles de la carte.
  couleur String @db.VarChar(7)

  suggestions Suggestion[]

  @@map("categories")
}

model Tag {
  id  Int    @id @default(autoincrement())
  nom String @unique @db.VarChar(30)

  suggestions Suggestion[]

  @@map("tags")
}

/// Un quartier, avec le point sur lequel centrer la carte.
model Localisation {
  id        Int    @id @default(autoincrement())
  nom       String @unique @db.VarChar(80)
  slug      String @unique @db.VarChar(80)
  ville     String @db.VarChar(80)
  latitude  Float
  longitude Float

  suggestions Suggestion[]

  @@map("localisations")
}

/// PUBLIEE : visible de tous. EN_ATTENTE : visible de l'auteur et des modérateurs. REJETEE : idem, avec un motif.
enum StatutModeration {
  PUBLIEE
  EN_ATTENTE
  REJETEE

  @@map("statut_moderation")
}

/// Une idée proposée par un habitant.
model Suggestion {
  id             Int      @id @default(autoincrement())
  titre          String   @db.VarChar(120)
  description    String
  /// Position précise facultative : sans elle, l'idée n'apparaît pas sur la carte.
  latitude       Float?
  longitude      Float?
  /// Compteur dénormalisé depuis `votes`, pour trier en SQL.
  likes          Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  auteurId       Int      @map("auteur_id")
  categorieId    Int      @map("categorie_id")
  localisationId Int      @map("localisation_id")
  statut           StatutModeration @default(PUBLIEE)
  /// Pourquoi l'idée a été mise de côté, pour le modérateur.
  motifsModeration String[]         @default([]) @map("motifs_moderation")
  /// Ce qui a analysé l'idée : regles, ia ou signalements.
  analyseePar      String?          @map("analysee_par") @db.VarChar(20)
  /// Message du modérateur à l'auteur.
  noteModeration   String?          @map("note_moderation") @db.VarChar(500)
  /// Date de la dernière décision humaine. Seuls les signalements postérieurs comptent ensuite.
  moderatedAt      DateTime?        @map("moderated_at")

  auteur       User          @relation(fields: [auteurId], references: [id], onDelete: Cascade)
  categorie    Categorie     @relation(fields: [categorieId], references: [id], onDelete: Restrict)
  localisation Localisation  @relation(fields: [localisationId], references: [id], onDelete: Restrict)
  tags         Tag[]
  piecesJointes PieceJointe[]
  votes        Vote[]
  signalements Signalement[]

  @@index([createdAt])
  @@index([likes])
  @@index([statut, createdAt])
  @@index([categorieId])
  @@index([localisationId])
  @@map("suggestions")
}

/// Un document joint à une idée. Le fichier est sur le disque, seules ses métadonnées sont ici.
model PieceJointe {
  id           Int      @id @default(autoincrement())
  nomOriginal  String   @map("nom_original") @db.VarChar(255)
  nomStockage  String   @unique @map("nom_stockage") @db.VarChar(64)
  typeMime     String   @map("type_mime") @db.VarChar(120)
  taille       Int
  createdAt    DateTime @default(now()) @map("created_at")
  suggestionId Int      @map("suggestion_id")

  suggestion Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@index([suggestionId])
  @@map("pieces_jointes")
}

/// Un signalement par habitant et par idée.
model Signalement {
  userId       Int      @map("user_id")
  suggestionId Int      @map("suggestion_id")
  motif        String   @db.VarChar(30)
  createdAt    DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  suggestion Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@id([userId, suggestionId])
  @@index([suggestionId])
  @@map("signalements")
}

/// Un j'aime par habitant et par idée.
model Vote {
  userId       Int      @map("user_id")
  suggestionId Int      @map("suggestion_id")
  createdAt    DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  suggestion Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@id([userId, suggestionId])
  @@index([suggestionId])
  @@map("votes")
}
