// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

// #TODO Changer le schéma model selon le schéma cible
model Customer {
  id        String @id @default(uuid())
  name      String
  email     String @unique
  imageUrl  String
  Invoices Invoices[]
}

enum InvoiceStatus {
  pending
  paid
}

model Invoices {
  id          String @id @default(uuid())
  customerId  String
  amount       Int
  status      InvoiceStatus
  date        String
  Customer    Customer @relation(fields: [customerId], references: [id])
}

model Revenue {
  month       String @id
  revenue     Int
}

model User {
  id          String @id @default(uuid())
  name        String
  email       String @unique
  password    String
}